<launch>
  <!-- Kinova Joystick Controller Launch File -->
  
  <arg name="robot_namespace" default="my_gen3"/>
  <arg name="dev" default="/dev/input/js0"/>
  <arg name="use_servo" default="false"/>
  
  <!-- Launch joy node to read joystick input -->
  <node pkg="joy" type="joy_node" name="joy" output="screen">
    <param name="dev" value="$(arg dev)" />
    <param name="deadzone" value="0.05" />
    <param name="autorepeat_rate" value="20" />
    <param name="coalesce_interval" value="0.025" />
  </node>
  
  <!-- Optionally launch servo -->
  <include file="$(find kortex_examples)/launch/servo.launch" if="$(arg use_servo)">
    <arg name="robot_namespace" value="$(arg robot_namespace)"/>
  </include>
  
  <!-- Launch the custom Kinova joystick controller -->
  <node pkg="kortex_examples" type="kinova_joystick_controller.py" name="kinova_joystick_controller" output="screen">
    <param name="robot_namespace" value="$(arg robot_namespace)"/>
  </node>
  
</launch>